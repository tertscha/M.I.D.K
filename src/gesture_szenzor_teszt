#include "MatrixMiniR4.h"

int gesture;

void printit(const char* text, int row = 10, int column = 10)
{
  MiniR4.OLED.setCursor(column, row);
  MiniR4.OLED.print(text);
  MiniR4.OLED.display();
}
void setStatusLed(uint8_t n, uint8_t r, uint8_t g, uint8_t b) {
  // n: can be 1 or 2 which led
  MiniR4.LED.setColor(n, r, g, b);
}
void setup()
{
  MiniR4.begin();
  MiniR4.PWR.setBattCell(2);
  Serial.begin(9600);
  MiniR4.I2C2.MXGesture.begin();
}

void loop()
{
  gesture = MiniR4.I2C2.MXGesture.getGesture();
  MiniR4.OLED.clearDisplay();
  MiniR4.OLED.setCursor(10, 20);
  MiniR4.OLED.print(gesture);
  MiniR4.OLED.display();
  printit ("Rozi vagyok XD.", 20);
  MiniR4.LED.setColor(1, 250, 2, 2);
  if(gesture == 3) //le
  {
    printit("hatra");
    setStatusLed(1,0,255,0); //green
    //MiniR4.OLED.setCursor(10, 10);
    //MiniR4.OLED.print("hatra");
    //MiniR4.OLED.display();
  }
  if(gesture == 9) //wave
  {
    printit("allj");
    setStatusLed(1,250,2,2); //piros
    //MiniR4.OLED.setCursor(10, 10);
    //MiniR4.OLED.print("allj");
    //MiniR4.OLED.display();
  }
  if(gesture == 4)
  {
    printit("elore");
    setStatusLed(1,2,209,250); //blue
    //MiniR4.OLED.setCursor(10, 10);
    //MiniR4.OLED.print("elore");
    //MiniR4.OLED.display();
  }
  if(gesture == 2)
  {
    MiniR4.OLED.setCursor(10, 10);
    MiniR4.OLED.print("left");
    MiniR4.OLED.display();
  }
  if(gesture == 1)
  {
    MiniR4.OLED.setCursor(10, 10);
    MiniR4.OLED.print("right");
    MiniR4.OLED.display();
  }
  delay(500);

}
